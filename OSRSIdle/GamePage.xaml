<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OSRSIdle"
    x:Class="OSRSIdle.GamePage"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Black">

    <Grid
    x:Name="MainGrid"
    RowDefinitions="*,Auto,Auto"
    BackgroundColor="Black">

        <!-- ================================================= -->
        <!-- GAME CONTENT                                      -->
        <!-- ================================================= -->

        <ContentView
            x:Name="GameContent"
            Grid.Row="0" />


        <!-- ================================================= -->
        <!-- NOTIFICATION / ANIMATION LAYER                   -->
        <!-- ================================================= -->

        <AbsoluteLayout
            x:Name="NotificationLayer"
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            ZIndex="100"
            InputTransparent="True" />


        <!-- ================================================= -->
        <!-- DEATH SCREEN                                      -->
        <!-- ================================================= -->

        <Grid
            x:Name="DeathOverlay"
            Grid.Row="0"
            BackgroundColor="Black"
            IsVisible="False"
            Opacity="0"
            InputTransparent="False">

            <VerticalStackLayout
                Spacing="25"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="30">

                <!-- Death message -->

                <Label
                    x:Name="DeathMessageLabel"
                    Text="OH DEAR, YOU ARE DEAD..."
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="Red"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <!-- Countdown -->

                <Label
                    x:Name="DeathCountdownLabel"
                    Text="Respawning in 600 ticks..."
                    FontSize="20"
                    TextColor="White"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Grid>


        <!-- ================================================= -->
        <!-- OFFLINE COMBAT SIMULATION                         -->
        <!-- ================================================= -->

        <Grid
            x:Name="OfflineCombatOverlay"
            Grid.Row="0"
            BackgroundColor="Transparent"
            IsVisible="False"
            InputTransparent="False">

            <!-- The dialog panel sits above this hit target. Tapping the
                 surrounding area closes item descriptions without allowing
                 the tap to reach the page underneath. -->
            <Grid
                x:Name="CustomDialogDismissArea"
                BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCustomDialogBackgroundTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <Border
                Style="{StaticResource GamePanelBorder}"
                Margin="28"
                MaximumWidthRequest="340"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="12">

                    <Label
                        x:Name="OfflineCombatTitleLabel"
                        Text="SIMULATING COMBAT"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#FFE26A"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="OfflineCombatProgressLabel"
                        FontSize="17"
                        TextColor="#FFE26A"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <ProgressBar
                        x:Name="OfflineCombatProgressBar"
                        Progress="0"
                        ProgressColor="#2D7D46" />

                    <Label
                        Text="LOOT OBTAINED"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#FFE26A"
                        HorizontalOptions="Center" />

                    <Border
                        Stroke="#D99032"
                        StrokeThickness="1"
                        Padding="6"
                        HeightRequest="150">

                        <ScrollView>
                            <VerticalStackLayout
                                x:Name="OfflineCombatLootList"
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="No loot yet."
                                    FontSize="15"
                                    TextColor="#FFE26A"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>
                        </ScrollView>

                    </Border>

                    <Label
                        x:Name="OfflineCombatResultLabel"
                        FontAttributes="Bold"
                        TextColor="#FFE26A"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center">

                        <local:GoldSliceButton
                            x:Name="OfflineCombatContinueButton"
                            Text="Simulating..."
                            Variant="Neutral"
                            TextColor="White"
                            IsEnabled="False"
                            WidthRequest="128"
                            CenterText="True"
                            Clicked="OnOfflineCombatContinueClicked" />

                        <local:GoldSliceButton
                            x:Name="OfflineCombatCancelButton"
                            Text="Cancel"
                            Variant="Red"
                            TextColor="White"
                            WidthRequest="128"
                            CenterText="True"
                            Clicked="OnOfflineCombatCancelClicked" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- OFFLINE SKILLING SUMMARY                          -->
        <!-- ================================================= -->

        <Grid
            x:Name="OfflineSkillingOverlay"
            Grid.Row="0"
            BackgroundColor="Transparent"
            IsVisible="False"
            InputTransparent="False">

            <Border
                Style="{StaticResource GamePanelBorder}"
                Margin="28"
                MaximumWidthRequest="340"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="OFFLINE SKILLING"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#FFE26A"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="OfflineSkillingSummaryLabel"
                        FontSize="17"
                        TextColor="#FFE26A"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="REWARDS OBTAINED"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#FFE26A"
                        HorizontalOptions="Center" />

                    <VerticalStackLayout
                        x:Name="OfflineSkillingRewardsList"
                        Spacing="5"
                        HorizontalOptions="Center" />

                    <local:GoldSliceButton
                        Text="Continue"
                        Variant="Green"
                        TextColor="White"
                        WidthRequest="128"
                        HorizontalOptions="Center"
                        CenterText="True"
                        Clicked="OnOfflineSkillingContinueClicked" />

                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- CUSTOM DIALOG                                    -->
        <!-- ================================================= -->

        <Grid
            x:Name="CustomDialogOverlay"
            Grid.Row="0"
            BackgroundColor="#D0000000"
            IsVisible="False"
            InputTransparent="False">

            <Border
                Style="{StaticResource GamePanelBorder}"
                Margin="28"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <Label
                        x:Name="CustomDialogTitleLabel"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="#2D7D46"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Border
                        x:Name="CustomDialogItemImageFrame"
                        Stroke="#D99032"
                        StrokeThickness="2"
                        Padding="5"
                        WidthRequest="110"
                        HeightRequest="110"
                        HorizontalOptions="Center"
                        IsVisible="True">

                        <Image
                            x:Name="CustomDialogItemImage"
                            WidthRequest="96"
                            HeightRequest="96"
                            Aspect="AspectFit" />

                    </Border>

                    <Border
                        x:Name="CustomDialogItemDescriptionFrame"
                        Stroke="#D99032"
                        StrokeThickness="1"
                        BackgroundColor="#3A3A3A"
                        Padding="8"
                        IsVisible="True">

                        <ScrollView
                            MaximumHeightRequest="220"
                            VerticalScrollBarVisibility="Always">

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    x:Name="CustomDialogMessageLabel"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="CustomDialogUpgradeLabel"
                                    FontSize="14"
                                    TextColor="#FFE26A"
                                    HorizontalTextAlignment="Center"
                                    IsVisible="False" />
                            </VerticalStackLayout>

                        </ScrollView>

                    </Border>

                    <FlexLayout
                        x:Name="CustomDialogButtons"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Center" />

                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- PERSISTENT ACTIVITY BAR                           -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="1">

            <ContentView
                x:Name="ActivityBarContainer" />

        </Grid>


        <!-- ================================================= -->
        <!-- NAVIGATION                                        -->
        <!-- ================================================= -->

        <Grid
            x:Name="NavigationBar"
            Grid.Row="2"
            HeightRequest="53"
            ColumnDefinitions="*,*,*,*,*,*">

            <Image
                Grid.ColumnSpan="6"
                Source="navigation_bar_background.png"
                Aspect="Fill"
                InputTransparent="True" />

            <Grid
                x:Name="NavigationButtonsGrid"
                Grid.ColumnSpan="6"
                Padding="5"
                ColumnDefinitions="*,*,*,*,*,*">

            <Border
                x:Name="HomeNavigationButton"
                Grid.Column="0"
                BackgroundColor="#D92D7D46"
                Padding="4">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked" />
                </Border.GestureRecognizers>

                <Image
                    Source="nav_home.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <Border
                x:Name="SkillsNavigationButton"
                Grid.Column="1"
                BackgroundColor="Transparent"
                Padding="4">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSkillsClicked" />
                </Border.GestureRecognizers>

                <Image
                    Source="nav_skills.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <Border
                x:Name="CombatNavigationButton"
                Grid.Column="2"
                BackgroundColor="Transparent"
                Padding="4">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCombatClicked" />
                </Border.GestureRecognizers>

                <Image
                    Source="nav_combat.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <Border
                x:Name="InventoryNavigationButton"
                Grid.Column="3"
                BackgroundColor="Transparent"
                Padding="4">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInventoryClicked" />
                </Border.GestureRecognizers>

                <Image
                    Source="nav_inventory.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <Border
                x:Name="CollectionNavigationButton"
                Grid.Column="4"
                BackgroundColor="Transparent"
                Padding="4">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCollectionLogClicked" />
                </Border.GestureRecognizers>

                <Image
                    Source="nav_collection.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <Border
                x:Name="SettingsNavigationButton"
                Grid.Column="5"
                BackgroundColor="Transparent"
                Padding="4">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsClicked" />
                </Border.GestureRecognizers>

                <Image
                    Source="nav_settings.png"
                    WidthRequest="32"
                    HeightRequest="32"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            </Grid>

        </Grid>


        <!-- ================================================= -->
        <!-- DEBUG FPS COUNTER                                -->
        <!-- ================================================= -->

        <Border
            x:Name="FpsDebugOverlay"
            IsVisible="False"
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="0,8,8,0"
            Padding="6,2"
            HorizontalOptions="End"
            VerticalOptions="Start"
            BackgroundColor="#CC101010"
            Stroke="#FFE26A"
            StrokeThickness="1"
            ZIndex="1000"
            InputTransparent="True">

            <Label
                x:Name="FpsDebugLabel"
                Text="FPS: --"
                FontSize="12"
                TextColor="#FFE26A" />

        </Border>

    </Grid>

</ContentPage>
