<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OSRSIdle"
    x:Class="OSRSIdle.SettingsView">

    <Grid>
        <Image Source="background_settings.png" Aspect="AspectFill" Opacity="0.72" InputTransparent="True" />

        <ScrollView>
            <Border Style="{StaticResource GamePanelBorder}" Margin="12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="SETTINGS" FontSize="28" HorizontalOptions="Center" />
                    <Label Text="DEBUG OPTIONS" FontSize="18" TextColor="#FFE26A" HorizontalOptions="Center" />

                    <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Debug 20× ticks" FontSize="13" VerticalOptions="Center" />
                        <Switch x:Name="DebugSpeedSwitch" Scale="0.82" Toggled="OnDebugSpeedToggled" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Debug 100× ticks" FontSize="13" VerticalOptions="Center" />
                        <Switch x:Name="ExtremeDebugSpeedSwitch" Scale="0.82" Toggled="OnExtremeDebugSpeedToggled" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Debug instakill" FontSize="13" VerticalOptions="Center" />
                        <Switch x:Name="InstakillSwitch" Scale="0.82" Toggled="OnInstakillToggled" />
                    </HorizontalStackLayout>

                    <local:GoldSliceButton Text="Show Test Notification" Variant="Neutral" TextColor="White" HorizontalOptions="Center" WidthRequest="300" Clicked="OnShowTestNotificationClicked" />

                    <BoxView HeightRequest="1" BackgroundColor="#80D99032" Margin="0,4" />

                    <local:GoldSliceButton Text="Return to Character Select" Variant="Neutral" TextColor="White" HorizontalOptions="Center" WidthRequest="300" Clicked="OnReturnToCharacterSelectClicked" />
                    <local:GoldSliceButton Text="Reset Character" Variant="Red" TextColor="White" HorizontalOptions="Center" WidthRequest="300" Clicked="OnResetProgressClicked" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <Grid x:Name="ResetConfirmationOverlay" BackgroundColor="#D0000000" IsVisible="False" InputTransparent="False">
            <Border Style="{StaticResource GamePanelBorder}" Margin="28" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="ResetConfirmationTitle" Text="RESET CHARACTER?" FontSize="23" FontAttributes="Bold" TextColor="#FFE26A" HorizontalOptions="Center" />
                    <Label x:Name="ResetConfirmationMessage" FontSize="17" HorizontalTextAlignment="Center" />
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <local:GoldSliceButton Text="Cancel" Variant="Neutral" TextColor="White" Clicked="OnCancelResetClicked" />
                        <local:GoldSliceButton x:Name="ResetConfirmationButton" Text="Continue" WidthRequest="150" FontSize="13" Variant="Red" TextColor="White" Clicked="OnConfirmResetClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
