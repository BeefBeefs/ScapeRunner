<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OSRSIdle.MainPage"
    Title="OSRS Idle">

    <Grid BackgroundColor="Black">

        <Image
            Source="background_home.png"
            Aspect="AspectFill"
            Opacity="0.30"
            InputTransparent="True" />

        <ScrollView>

            <VerticalStackLayout
                Padding="20"
                Spacing="15">

            <Label
                Text="OSRS IDLE"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Skills"
                FontSize="20"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />

            <!-- Skills will be generated here -->

            <VerticalStackLayout
                x:Name="SkillList"
                Spacing="10" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
